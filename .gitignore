# Gradle
.gradle/
build/
# Kotlin 2.x build metadata + error logs (trailing comments are NOT
# supported in .gitignore -- they become part of the pattern)
.kotlin/
# JVM heap dumps -- Gradle writes these on OOM and they are enormous
*.hprof

# IDE
.idea/
*.iml
local.properties

# Agent / editor scratch — but agent definitions are project config and versioned
.claude/*
!.claude/agents/

# macOS
.DS_Store
